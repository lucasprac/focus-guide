{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "isolatedModules": true,
    "noEmit": true, "types": ["node", "vite/client"], "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "electron.vite.config.ts", "preview.vite.config.ts"]
}
